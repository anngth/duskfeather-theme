  "tokenColors": [
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "meta.diff.header.git",
        "meta.diff.header.from-file",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#4876d6"
      }
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted.diff",
      "settings": {
        "foreground": "#EF535090"
      }
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted.diff",
      "settings": {
        "foreground": "#4876d6ff"
      }
    },
    {
      "name": "Global settings",
      "settings": {
        "background": "#FBFBFB",
        "foreground": "#403f53"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
